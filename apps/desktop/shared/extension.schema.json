{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://writer.app/schemas/extension.json",
  "title": "Writer Extension Manifest",
  "description": "Contract for `writer.json`. Read by Rust (include_str! in extensions/manifest.rs) and by TypeScript (packages/extension-api/src/manifest.ts). Single source of truth for both sides.",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "commands"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier. Namespaces storage and grants; changing it is a new extension."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?$",
      "description": "Semver. Must equal the GitHub release tag (leading `v` tolerated)."
    },
    "minWriterVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "icon": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },

    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "title"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Key in the bundle's exported command map."
          },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "description": { "type": "string" },
          "mode": {
            "enum": ["view", "no-view"],
            "default": "view",
            "description": "`view` renders UI; `no-view` runs and exits (fire-and-forget)."
          },
          "surface": {
            "enum": ["palette", "panel", "sidebar"],
            "default": "palette",
            "description": "Where the command's UI is hosted."
          },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "title"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "type": {
            "enum": ["text", "password", "checkbox", "dropdown", "number"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "data": {
            "type": "array",
            "description": "Options for `dropdown`.",
            "items": {
              "type": "object",
              "required": ["title", "value"],
              "properties": {
                "title": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "capabilities": {
      "type": "object",
      "description": "Closed set. Anything absent is denied. Every entry needs a `reason` shown verbatim at consent time.",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob allowlist, workspace-relative. Enforced in Rust on the canonicalized real path."
            },
            "write": { "type": "array", "items": { "type": "string" } },
            "delete": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "network": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "domains": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Explicit host allowlist. `[]` means no network. `*` is a runtime-consent tier."
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "ai": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": { "reason": { "type": "string", "minLength": 1 } }
        },
        "embeddings": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "write": {
              "type": "boolean",
              "default": false,
              "description": "May build/maintain the index, not just query it."
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "clipboard": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "read": { "type": "boolean", "default": false },
            "write": { "type": "boolean", "default": false },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shared": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Shared namespaces to join. Both sides must declare the namespace and the user must consent."
            },
            "reason": { "type": "string" }
          }
        },
        "services": {
          "type": "object",
          "description": "Inter-extension RPC. A provider exposes named methods; a consumer names the services it calls.",
          "additionalProperties": false,
          "properties": {
            "provides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "methods", "description"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                  "description": { "type": "string" },
                  "methods": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            },
            "uses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["extension", "service", "reason"],
                "additionalProperties": false,
                "properties": {
                  "extension": { "type": "string" },
                  "service": { "type": "string" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
